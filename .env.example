# Polymarket Bot Konfiguration
# Kopiere diese Datei zu .env und trage deine Werte ein

# Dein Polygon Wallet Private Key (NIEMALS teilen!)
PRIVATE_KEY=0xdein_private_key_hier

# Bet-Größe in USDC pro Trade
BET_SIZE=5

# Minimaler Signal-Score (0-100) um einen Trade auszuführen
MIN_SIGNAL_SCORE=65

# Polymarket Market Condition ID für BTC 5-min Up/Down
# Findest du auf polymarket.com → Bitcoin Market → URL
MARKET_CONDITION_ID=

# Optional: Telegram Bot für Benachrichtigungen
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
