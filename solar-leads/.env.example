# ============================================================================
#  Solar-Lead-System Österreich — Umgebungsvariablen
# ============================================================================
#
#  ANLEITUNG:
#    1. Kopiere diese Datei zu ".env"   (im selben Ordner)
#         cp .env.example .env
#    2. Trage deine echten Schlüssel ein (rechts vom = Zeichen)
#    3. Die .env-Datei NIEMALS in Git committen oder weitergeben!
#       (Sie ist bereits in .gitignore ausgeschlossen.)
#
#  Du brauchst NICHT alle Keys sofort. Für den ersten Workflow
#  (Adresse -> Solar-API -> Dacheignung) reicht GOOGLE_MAPS_API_KEY.
# ============================================================================


# ----------------------------------------------------------------------------
# Google Cloud  (Maps Static API + Solar API + Geocoding API)
# ----------------------------------------------------------------------------
# So bekommst du den Key:
#   1. https://console.cloud.google.com  -> Projekt anlegen
#   2. "APIs & Services" -> "Library" -> diese 3 APIs aktivieren:
#         - Maps Static API
#         - Solar API
#         - Geocoding API
#   3. "APIs & Services" -> "Credentials" -> "Create Credentials" -> "API key"
#   4. WICHTIG: Abrechnung (Billing) aktivieren, sonst antworten die APIs mit Fehler.
# Ein Key funktioniert für alle drei APIs.
GOOGLE_MAPS_API_KEY=

# Optional: separater Key nur für die Solar API (sonst wird GOOGLE_MAPS_API_KEY genutzt).
GOOGLE_SOLAR_API_KEY=


# ----------------------------------------------------------------------------
# Supabase  (Datenbank + Storage)
# ----------------------------------------------------------------------------
# So bekommst du die Werte:
#   1. https://supabase.com -> Projekt anlegen
#   2. Project Settings -> "API"
#         - "Project URL"          -> SUPABASE_URL
#         - "service_role" secret  -> SUPABASE_SERVICE_KEY  (NUR serverseitig nutzen!)
# Der service_role-Key umgeht die Sicherheitsregeln — niemals im Browser/Frontend verwenden.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=


# ----------------------------------------------------------------------------
# Cloudflare R2  (Bildspeicher — S3-kompatibel)
# ----------------------------------------------------------------------------
# So bekommst du die Werte:
#   1. Cloudflare Dashboard -> R2 -> "Create bucket" (z.B. "solar-images")
#   2. R2 -> "Manage R2 API Tokens" -> "Create API token"
#         - Access Key ID     -> R2_ACCESS_KEY_ID
#         - Secret Access Key -> R2_SECRET_ACCESS_KEY
#   3. Account-ID steht in der R2-Übersicht -> R2_ACCOUNT_ID
#   4. Öffentliche URL: im Bucket "Public access" / "Custom Domain" aktivieren -> R2_PUBLIC_URL
# (Für den allerersten Workflow optional — Bilder werden sonst lokal in ./output gespeichert.)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=solar-images
R2_PUBLIC_URL=


# ----------------------------------------------------------------------------
# fal.ai  (Flux Kontext — KI-Rendering der Solarpanels)
# ----------------------------------------------------------------------------
# https://fal.ai -> Dashboard -> "API Keys"
FAL_KEY=


# ----------------------------------------------------------------------------
# Post.at  (Postkarten-Versand) — kommt in einem späteren Schritt
# ----------------------------------------------------------------------------
# Zugang über das Post.at Business-/Entwicklerportal.
# Falls du eine Alternative nutzt (z.B. eine White-Label-Postkarten-API), hier eintragen.
POSTAT_API_KEY=
POSTAT_API_SECRET=
# Absenderadresse (erscheint auf der Postkarte)
SENDER_NAME=
SENDER_STREET=
SENDER_ZIP=
SENDER_CITY=


# ----------------------------------------------------------------------------
# Wirtschaftlichkeits-Annahmen (ROI-Rechner)  — anpassbar an den Markt
# ----------------------------------------------------------------------------
# Diese Werte fließen in die Kosten-/Ersparnis-Berechnung ein.
# Stand 2025/2026 für Österreich — bei Bedarf aktualisieren.

# Installationskosten pro kWp (schlüsselfertig, inkl. Montage), in Euro.
COST_PER_KWP_EUR=1400

# Strompreis pro kWh, in Euro (Haushaltstarif Österreich).
ELECTRICITY_PRICE_EUR=0.25

# Einspeisevergütung pro kWh, in Euro (Überschuss-Einspeisung).
FEED_IN_TARIFF_EUR=0.07

# Eigenverbrauchsquote (0–1): Anteil des Stroms, der selbst genutzt wird.
# Rest wird zum FEED_IN_TARIFF eingespeist. 0.30 = 30 % Eigenverbrauch.
SELF_CONSUMPTION_RATE=0.30

# Leistung eines einzelnen Panels in Watt (zur Umrechnung Panel-Anzahl -> kWp).
PANEL_WATTS=400
